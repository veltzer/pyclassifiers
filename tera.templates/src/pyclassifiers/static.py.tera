{% set project = load_lua(path="config/project.lua") -%}
""" version which can be consumed from within the module """
VERSION_STR = "{{ toml_get(path="pyproject.toml", key="project.version") }}"
DESCRIPTION = "{{ project.DESCRIPTION_SHORT }}"
APP_NAME = "{{ project.NAME }}"
LOGGER_NAME = "{{ project.NAME }}"
